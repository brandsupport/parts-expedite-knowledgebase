{
  "name": "parts-expedite-knowledgebase",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply parts-expedite-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply parts-expedite-db --remote",
    "db:status:remote": "wrangler d1 migrations list parts-expedite-db --remote",
    "check": "node --check js/app.js && node --check backend/worker.js && node --check scripts/build-static.mjs"
  },
  "devDependencies": {
    "wrangler": "latest"
  }
}
