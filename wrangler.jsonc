{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parts-expedite-kb",
  "compatibility_date": "2026-11-27",
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parts-expedite-db",
      "database_id": "614c9444-160b-4db1-a061-5661185e7cef",
      "migrations_dir": "backend/migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "AUTH_ENABLED": "true"
  }
}
