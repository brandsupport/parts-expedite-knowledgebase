{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parts-expedite-api",
  "main": "backend/worker.js",
  "compatibility_date": "2026-11-27",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parts-expedite-db",
      "database_id": "614c9444-160b-4db1-a061-5661185e7cef",
      "migrations_dir": "backend/migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "AUTH_ENABLED": "false"
  }
}
