{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parts-expedite-api",
  "main": "backend/worker.js",
  "compatibility_date": "2026-11-27",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parts-expedite-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "backend/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "parts-expedite-media"
    }
  ],
  "vars": {
    "APP_ENV": "production"
  }
}
